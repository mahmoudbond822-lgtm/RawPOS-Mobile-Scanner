# Normalize text files to LF; Windows batch files stay CRLF.
* text=auto eol=lf

*.kt text eol=lf
*.java text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.sh text eol=lf
gradlew text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.apk binary
*.aab binary
